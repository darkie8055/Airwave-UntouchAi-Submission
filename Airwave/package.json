{
  "name": "airwave-youtube-gestures",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first hand gesture controls for YouTube — Chrome Manifest V3 extension",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
